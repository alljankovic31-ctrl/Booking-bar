{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "dj_name": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "dj_night",
        "themed_party",
        "vip_event",
        "special"
      ],
      "default": "dj_night"
    },
    "image_url": {
      "type": "string"
    },
    "ticket_price": {
      "type": "number"
    },
    "capacity": {
      "type": "number"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "sold_out",
        "cancelled",
        "completed"
      ],
      "default": "upcoming"
    }
  },
  "required": [
    "title",
    "date"
  ]
}